<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>AgentCord</RootNamespace>
    <AssemblyName>AgentCord</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>assets\agentcord.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.5.0</Version>
    <Description>Claude Code, Codex, Cursor, and Antigravity activity on your Discord profile</Description>
  </PropertyGroup>

  <!-- The project mixes WinForms (tray icon) and WPF (popover). Drop the
       WinForms implicit usings so WPF files aren't flooded with ambiguous
       type names (Color, Button, HorizontalAlignment, ...); WinForms files
       import their namespaces explicitly instead. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="AgentCord.Tests/**" />
    <EmbeddedResource Remove="AgentCord.Tests/**" />
    <None Remove="AgentCord.Tests/**" />
    <Page Remove="AgentCord.Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AgentCord.Tests" />
  </ItemGroup>

</Project>
